# Copy to native.ini, next to dw2003.exe. Every line is optional.

# Where the game read from your disc is (the first run writes it); relative to
# the exe's folder
data = data

# 1: start in fullscreen (F11 or Alt+Enter switches while playing)
fullscreen = 0

# The window's size, in 320x240 steps (3 = 960x720). Unset: the biggest that
# fits the screen (4 = 1280x960 on a 1080p one)
#scale = 3

# 1: battles in 16:9, the 3D seeing a third wider (the battle's menus and
# numbers stretched to it); the fields stay 4:3. The window is 16:9 then
widescreen = 0

# 1: the 3D's textures in perspective, without the PlayStation's warping
# (needs the options menu's Sub-pixel 3D)
perspective = 1

# 1: the 3D models' textures smoothed when enlarged, rather than in blocks;
# sprites and text stay sharp (needs Sub-pixel 3D)
smooth_3d = 1

# 1: the colours at 8 bits a channel, without the PlayStation's 5-bit banding;
# dithering is then left out
true_color = 1

# the picture on its way to the window, all 0 as the game's own:
# sharpen 0 to 10 (contrast-adaptive, keeps edges from ringing);
# brightness, gamma and saturation -10 to 10. Not on the movies
sharpen = 0
brightness = 0
gamma = 0
saturation = 0

# 1 to 10: dark lines between the game's rows, as a tube television's
# (best with integer_scale, or they beat against the screen's rows)
scanlines = 0

# 1: the picture a whole multiple of the game's 240 rows, with bars
# around it, so that every pixel of the game's is the same size
integer_scale = 0

# 1: the picture's jagged edges smoothed (SMAA), the rest left sharp
smaa = 0

# 1: with render_scale below the window's size, the 3D (the battles) is
# enlarged to the window by AMD's FSR 1 rather than plainly smoothed;
# for slow graphics cards. Best with some sharpen.
# 2: FSR 3.1, AMD's temporal upscaler, with the Direct3D 12 renderer (x64) only.
# 3: DLSS, NVIDIA's, the same, on an RTX card, with NVIDIA's Streamline files next to the exe.
# It needs AMD's two DLLs next to the exe (amd_fidelityfx_loader_dx12.dll and
# amd_fidelityfx_upscaler_dx12.dll, from the FidelityFX SDK) and a Resolution
# below the window's size; without them it works as 1. Takes the place of
# smaa on those frames. Choosing it in the options needs a restart
fsr = 0

# With fsr = 3 (DLSS): 0 DLAA, 1 Quality, 2 Balanced, 3 Performance.
upscale_mode = 1

# 0: no dithering (the PlayStation's, on shaded and blended polygons)
dither = 1

# 1: the Digimon in battle cast their shape on the ground (needs Sub-pixel 3D
# and the Depth buffer, both on by default)
battle_shadows = 1

# 1: battles get a sky, darker toward the top, and their stage's far side
# fades into it with distance (the painted horizon kept clear); 0: the
# original's flat background
battle_sky = 0

# 1: the shadows under the characters on the field darken the ground they
# fall on, with smooth edges at any resolution, instead of the original's grey
# disc (0)
soft_shadows = 0

# 0: no vsync: frames shown at once, which can tear in fullscreen
vsync = 1

# The 64-bit build's renderer: auto (Direct3D 12 where the graphics card has
# it, else OpenGL), d3d12 or gl. OpenGL takes over if Direct3D 12 can't start.
# The 32-bit build is OpenGL only. Needs a restart
renderer = auto

# 0: the movies with sharp pixels instead of smoothed when scaled up
smooth_movies = 1

# The gamepad (the first one plugged; an Xbox 360 pad or any SDL knows).
# deadzone: how far the sticks and triggers move before they count, 0-32767
deadzone = 3277
# 0: no vibration
rumble = 1

# The options menu's icons: ps1 (the game's own),
# ps3, ps4, ps5, xbox360, xboxone, xboxseries,
# switch, keyboard, or auto (the device used last)
icons = ps5
# Each button's keys (SDL's names, two at most) and gamepad button (SDL's:
# a b x y by place, leftshoulder, lefttrigger, leftstick, dpup, start...),
# or none; the options menu's Controls writes them. The buttons: cross,
# circle, square, triangle, l1, r1, l2, r2, l3, r3, start, select, up, down,
# left, right
#keys_cross = Z, Space
#pad_cross = a

# 1-8: the game drawn on the graphics card (OpenGL 3.3) that many times
# finer than the PSX's 320x240, the 3D vertices with their fractions.
# Unset: as the window's size, up to 4
#render_scale = 4

# 50 as the European original, or 60: the game's own 60 Hz mode (its NTSC
# timing). Esc in game opens the options menu, which writes this file back
fps = 50

# 1: holding X advances the texts (outside battles and card games, where X
# confirms commands). Tab or R3 cycles fast forward (x2, x3, x5), not saved
fast_text = 1

# 1: on the map screen, X on a visited area asks, and Yes takes you there
# (through a door into it that is open at that point of the story)
fast_travel = 0

# 1: the map screen blinks the area where the story's next step happens
map_objective = 0

# 1: a journal row in the field menu (work in progress)
journal = 0

# 1: three more starter packs to choose from in a new game (Dragon, Tactical,
# Mystic)
extra_packs = 1

# 1: partners can learn BladeGarurumon, a 45th Digimon (Growlmon and Grizzmon
# at level 40), with its signature Solar Laser
bladegarurumon = 1

# What the game does while its window is not the one in front (minimised, or
# another window has the focus): 0 nothing, 1 mute the sound, 2 pause it all.
inactive_window = 0

# 1: each party partner still above 0 HP at battle end gets the full partner
# EXP, and its selected or used digivolutions get full Digimon EXP. Knocked-out
# partners get neither. The report uses the setting it had when it began.
full_exp_share = 0

# 1: player techniques with prepared scripts 9/13 use the projectile, launch,
# impact and stage choices in technique_visuals.ini. Off uses the original
# values. Switches in game from the Mods tab; the next technique uses the new
# setting without restarting.
technique_visuals = 1

# 1: Wizardmon sells Sober Disk at all ten city item shops, and confused
# partners can choose Item beneath the six confused commands. Reopen the shop
# after changing this option in the Mods tab to refresh its Buy list.
sober_disk_shops = 0

# 1: a menu's cursor goes round at its ends: up from the first row to the last,
# down from the last to the first (the field menu, the item lists and shops, the
# techniques list). The other menus keep stopping at their ends.
menu_wrap = 0

# 1: the battle HUD names the partner's current form, which follows a
# digivolution, when its model changes, instead of its base form (long names
# are squeezed to fit the name box).
battle_form_name = 0

# 1: in fast forward (Tab / R3) a menu's cursor keeps moving at its normal pace
# when a direction is held, instead of racing at the game's speed.
ff_menu_speed = 0

# 1: the title screen shows New game / Continue at once, without waiting for
# Start on PRESS START (the ten seconds' timeout goes with it).
skip_press_start = 0

# 1: square held about two thirds of a second during a cutscene that takes
# the controls skips the rest of its dialogues and moves at once; what the scene
# does (the story, a map change) still happens. Also the welcome text that
# opens the name entry screen.
skip_scenes = 0

# 1: a partner that levels up in a battle gets its HP and MP back in full
# (not its Digimon's levels).
heal_on_levelup = 0

# 1: the field menu gets a SAVE row (before QUIT) to save wherever the player
# stands, not only at save points; loading puts the player back there. The
# save has the same format, so it loads with the option off too.
save_anywhere = 0

# 1: Search Crest and Counter Crest keep working with a weapon that poisons,
# paralyses, confuses, knocks out or drains (Search not with a critical
# weapon, which sets the same bonus). The game switches them off then. Triple
# Crest is unchanged: a triple hit skips the weapon's effect.
fix_equip_stacking = 0

# 0: the battle effects' own images (data/mods/effects/<id>/*.png) are left
# out and the game's play. Switches in game, from the Mods tab.
custom_effects = 1

# 0: the effects' own sounds (the "sound" of data/mods/effects/<id>/effect.json)
# are left out. Switches in game, from the Mods tab.
custom_sounds = 1

# 0: the battle scripts of data/mods/scripts/<fighter>/<script>.json are left
# out and the game's own run. Switches in game, from the Mods tab.
custom_scripts = 1

# 1: debug keys. F1 the developers' stage select (stages, sound test, test
# battles), F3 the sound test, F4 the vibration test, F2 the game state to game_<n>.bin, F5 / F9 save / load a state
# (saves/quick.state, only for this same build)
debug = 0

# Logs to the console, per subsystem: cd, snd, pad, mc, ovl, gpu or all
# (also the DW3_LOG environment variable)
log =
