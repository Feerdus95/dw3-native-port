# Copy to native.ini, next to dw2003.exe. Every line is optional.

# Where the game read from your disc is (the first run writes it); relative to
# the exe's folder
data = data

# 1: start in fullscreen (F11 or Alt+Enter switches while playing)
fullscreen = 0

# The window's size, in 320x240 steps (3 = 960x720). Unset: the biggest that
# fits the screen (4 = 1280x960 on a 1080p one)
#scale = 3

# 1: battles in 16:9, the 3D seeing a third wider (the battle's menus and
# numbers stretched to it); the fields stay 4:3. The window is 16:9 then
widescreen = 0

# 1: the 3D's textures in perspective, without the PlayStation's warping
# (needs the options menu's Sub-pixel 3D)
perspective = 1

# 1: the 3D models' textures smoothed when enlarged, rather than in blocks;
# sprites and text stay sharp (needs Sub-pixel 3D)
smooth_3d = 1

# 1: the colours at 8 bits a channel, without the PlayStation's 5-bit banding;
# dithering is then left out
true_color = 1

# 0: no dithering (the PlayStation's, on shaded and blended polygons)
dither = 1

# 1: the Digimon in battle cast their shape on the ground (needs Sub-pixel 3D
# and the Depth buffer, both on by default)
battle_shadows = 1

# 1: battles get a sky, darker toward the top, and their stage's far side
# fades into it with distance; 0: the original's flat background. Stages
# with a painted sky of their own keep it as it is
battle_sky = 0

# 1: the shadows under the characters on the field darken the ground they
# fall on, with smooth edges at any resolution, instead of the original's grey
# disc (0)
soft_shadows = 0

# 0: no vsync: frames shown at once, which can tear in fullscreen
vsync = 1

# 0: the movies with sharp pixels instead of smoothed when scaled up
smooth_movies = 1

# The gamepad (the first one plugged; an Xbox 360 pad or any SDL knows).
# deadzone: how far the sticks and triggers move before they count, 0-32767
deadzone = 3277
# 0: no vibration
rumble = 1

# The options menu's icons: ps1 (the game's own),
# ps3, ps4, ps5, xbox360, xboxone, xboxseries,
# switch, keyboard, or auto (the device used last)
icons = ps5
# Each button's keys (SDL's names, two at most) and gamepad button (SDL's:
# a b x y by place, leftshoulder, lefttrigger, leftstick, dpup, start...),
# or none; the options menu's Controls writes them. The buttons: cross,
# circle, square, triangle, l1, r1, l2, r2, l3, r3, start, select, up, down,
# left, right
#keys_cross = Z, Space
#pad_cross = a

# 1-8: the game drawn on the graphics card (OpenGL 3.3) that many times
# finer than the PSX's 320x240, the 3D vertices with their fractions.
# Unset: as the window's size, up to 4
#render_scale = 4

# 50 as the European original, or 60: the game's own 60 Hz mode (its NTSC
# timing). Esc in game opens the options menu, which writes this file back
fps = 50

# 1: holding X advances the texts (outside battles and card games, where X
# confirms commands). Tab or R3 cycles fast forward (x2, x3, x5), not saved
fast_text = 1

# 1: on the map screen, X on a visited area takes you there as the menu closes
# (through a door into it that is open at that point of the story)
fast_travel = 0

# 1: the map screen blinks the area where the story's next step happens
map_objective = 0

# 1: a journal row in the field menu (work in progress)
journal = 0

# 1: three more starter packs to choose from in a new game (Dragon, Tactical,
# Mystic)
extra_packs = 1

# 1: partners can learn BladeGarurumon, a 45th Digimon (Growlmon and Grizzmon
# at level 40), with its signature Solar Laser
bladegarurumon = 1

# 1: debug keys. F1 the developers' stage select (stages, sound test, test
# battles), F3 the sound test, F4 the vibration test, F2 the game state to game_<n>.bin, F5 / F9 save / load a state
# (saves/quick.state, only for this same build)
debug = 0

# Logs to the console, per subsystem: cd, snd, pad, mc, ovl, gpu or all
# (also the DW3_LOG environment variable)
log =
