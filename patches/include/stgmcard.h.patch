+/* The window with the selected save's details (STGMCARD_updateInfo) */
+typedef struct MemCardInfo {
+    TASK_HEADER(MemCardInfo);
+    /* 0x50 */ MemCardSaves *saves;
+    /* 0x54 */ s32 layer;
+    /* 0x58 */ s32 depth;
+    /* 0x5C */ s32 drawing; /* the partners and frame are drawn */
