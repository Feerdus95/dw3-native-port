+    /* 0x60 */ s32 pad[2]; /* never read or written */
+    /* 0x68 */ s32 area; /* a string of TEXT_AREA_NAMES, from the previous mode */
+    /* 0x6C */ s32 place; /* a string of TEXT_SHOP_NAMES (STGMCARD_places) */
