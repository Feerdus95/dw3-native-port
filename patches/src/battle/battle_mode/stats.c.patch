@@ -53,6 +53,9 @@
     s16 *values;
     s32 count;
     s32 found;
+#ifdef NATIVE
+    s32 critWeapon = 0; /* a critical weapon: it and Search Crest both set criticalBonus (fix_equip_stacking) */
+#endif
     s32 i;
 
     if (which) {
@@ -182,18 +185,40 @@
                 } else if (values[i] == 0x96 || values[i] == 0xBF) {
                     stats->criticalBonus = data->weapon.statusPower;
                     found = 1;
+#ifdef NATIVE
+                    critWeapon = 1;
+#endif
                 }
             }
         }
+#ifdef NATIVE
+        /* fix_equip_stacking: Search and Counter Crest also work beside a special weapon (Search not beside a
+           critical one, which sets the same field); Triple Crest stays blocked, a triple hit skips the weapon's effect */
+        if (!found || g_fix_equip_stacking) {
+#else
         if (!found) {
+#endif
             values = &partner->equip[4];
             for (i = 0; i < 2; i++) {
+#ifdef NATIVE
+                if (values[i] == 0x13C) {
+                    if (!found) {
+                        stats->tripleHit = 1;
+                    }
+                } else if (values[i] == 0x13D) {
+                    if (!critWeapon) {
+                        data = ITEM_FUNCS.get(0x13D)->data.record;
+                        stats->criticalBonus = data->acc.amount;
+                    }
+                } else if (values[i] == 0x13E) {
+#else
                 if (values[i] == 0x13C) {
                     stats->tripleHit = 1;
                 } else if (values[i] == 0x13D) {
                     data = ITEM_FUNCS.get(0x13D)->data.record;
                     stats->criticalBonus = data->acc.amount;
                 } else if (values[i] == 0x13E) {
