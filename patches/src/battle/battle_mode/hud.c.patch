+/* The active partner's current form, or -1 (battle_form_name, native.h) */
+static s32 currentFormId(void) {
+    BattleFighter *fighter = &FIGHTSTG_battle.state.fighters[0][FIGHTSTG_battle.state.active[0]];
+
+    return GET_DIGIMON(fighter->id) != NULL ? fighter->id : -1;
+}
+
+/* Names the form in the window, and squeezes a name wider than the HP bar to a fixed advance that fits */
+static void showFormName(TextWindow *win, s32 form) {
+    s32 count;
+
+    win->setString(win, FILE_CACHE.load(TEXT_FILE(TEXT_DIGIMON_NAMES)), GET_DIGIMON(form)->nameId);
+    win->setSpacing(win, 0, 0);
+    if (measureText(&win->text[0], win->style, 0) > FORM_NAME_WIDTH) {
+        count = win->text[0].sjis != 0 ? win->text[0].len / 2 : win->text[0].len;
+        win->setSpacing(win, count > 0 ? FORM_NAME_WIDTH / count : 1, 0);
+    }
+}
+static s32 shownForm = -1;
+#endif
