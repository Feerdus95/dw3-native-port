+#ifdef NATIVE
+#define FORM_NAME_WIDTH 56 /* the name box, by trial (battle_form_name) */
+
+/* The active partner's form by its fighter, or -1 (battle_form_name, native.h) */
+static s32 currentFormId(void) {
+    BattleFighter *fighter = &FIGHTSTG_battle.state.fighters[0][FIGHTSTG_battle.state.active[0]];
+
+    return GET_DIGIMON(fighter->id) != NULL ? fighter->id : -1;
+}
+
+/* The fighter of the partner's model on screen, 0 for none: a digivolution's
+   fighter id changes when the form is chosen, but the model only when the effect swaps it in */
+static s32 modelFormId(void) {
+    Models *models = TASK_REGISTRY.funcs.find(BATTLE_TASK_MODELS, -1, -1);
+
+    return models != NULL ? models->getFighter(models, 0) : 0;
+}
+
+/* Names the form in the window, and shrinks a name wider than the box */
+static void showFormName(TextWindow *win, s32 form) {
+    s32 width;
+
+    win->setString(win, FILE_CACHE.load(TEXT_FILE(TEXT_DIGIMON_NAMES)), GET_DIGIMON(form)->nameId);
+    win->setScale(win, ONE, ONE);
+    width = measureText(&win->text[0], win->style, 0);
+    if (width > FORM_NAME_WIDTH) {
+        win->setPivot(win, 0xAE, 0x1B);
+        win->setScale(win, ONE * FORM_NAME_WIDTH / width, ONE * FORM_NAME_WIDTH / width);
+    }
+}
+static s32 shownModel;
+#endif
