 /* Creates a battle script, which plays a technique (FIGHTSTG_updateBattleScript) */
 BattleScript *FIGHTSTG_createBattleScript(void) {
+#ifdef NATIVE
+    BattleScript *script = createTask(FIGHTSTG_updateBattleScript, sizeof(BattleScript), 16 * sizeof(Task *));
+
+    script->nativeCritical = 0;
+    script->nativeStage = -1;
+    script->nativeTechId = 0;
+    script->nativeLaunchSoundChanged = 0;
+    script->nativeDeferredLaunchWait = 0;
+    script->nativeDeferredWaitStarted = 0;
+    return script;
+#else
     return createTask(FIGHTSTG_updateBattleScript, sizeof(BattleScript), 16 * sizeof(Task *));
+#endif
 }
 
