+/* Negative IDs identify only the launch commands in prepared scripts. */
+static s32 nativeLaunchId(BattleScript *script, s32 id, s32 field) {
+    if (id >= 0 || script->nativeTechId == 0 || script->enemy != 0 ||
+        (script->index != 9 && script->index != 13)) return id;
+    return native_visual_get(script->nativeTechId, field, -id);
