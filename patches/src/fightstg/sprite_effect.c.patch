+#ifdef NATIVE
+/* the critical hit's (FIGHTSTG_adjustDamage), for the next effects' own
+   images (native.h) */
+s32 FIGHTSTG_nativeCritical;
+
+/* A layer callback that draws an effect's own image (native.h) of the frame
+   its time is at, at its projected position as FIGHTSTG_drawSpriteAnim's, as
+   a GP0 1D packet for the graphics card. The packets go to a buffer of their
+   own */
+#define NATIVE_EFFECT_PACKETS 64
+static void nativeDrawEffect(void *arg, Layer *layer) {
+    static u_long packets[2][NATIVE_EFFECT_PACKETS][3];
+    static s32 used[2];
+    static u32 frame[2];
+    SpriteEffect *task = arg;
+    ShortVec3 screen;
+    s32 buf = GFX.buffer & 1;
+    u_long *p;
+
+    if (frame[buf] != native_frame()) {
+        frame[buf] = native_frame();
+        used[buf] = 0;
+    }
+    if (used[buf] == NATIVE_EFFECT_PACKETS) {
+        return;
+    }
+    if (task->pos.vz != 0x7FFF && task->pos.vz != -1) {
+        FIGHTSTG_battle.project(layer, &task->pos, &screen);
+    } else {
+        screen.x = task->pos.vx;
+        screen.y = task->pos.vy;
+        screen.z = task->pos.vz != 0x7FFF ? 0xFFF : 0;
+    }
+    p = packets[buf][used[buf]++];
+    p[0] = 2 << 24;
+    p[1] = 0x1D000000 | task->nativeImages << 12 | task->nativeTime / 2;
+    p[2] = (u16)screen.x | (u32)(u16)screen.y << 16;
+    addPrim(layer->getOtEntry(layer, screen.z), p);
+}
+#endif
