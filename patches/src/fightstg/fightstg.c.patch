+#ifdef NATIVE
+/* Where the polygon being added got its points (state->screen's words): their
+   fractions go to the packet with them, for the render scale (platform/gte.c) */
+static s32 *FIGHTSTG_sxyFrom[4];
+void gte_precise_copy(void *dst, const void *src);
+#define NATIVE_PRECISE3(prim)                                \
+    do {                                                      \
+        gte_precise_copy(&(prim)->x0, FIGHTSTG_sxyFrom[0]);   \
+        gte_precise_copy(&(prim)->x1, FIGHTSTG_sxyFrom[1]);   \
+        gte_precise_copy(&(prim)->x2, FIGHTSTG_sxyFrom[2]);   \
+    } while (0)
+#define NATIVE_PRECISE4(prim)                                \
+    do {                                                      \
+        NATIVE_PRECISE3(prim);                                \
+        gte_precise_copy(&(prim)->x3, FIGHTSTG_sxyFrom[3]);   \
+    } while (0)
+#endif
