-/* A tile of the map in view (FIELDSTG_drawMapTiles) */
-typedef struct MapSlot {
-    /* 0x00 */ s16 loaded; /* a StreamTask has its frame */
-    /* 0x02 */ s16 tile;
-    /* 0x04 */ StreamTask *stream;
-    /* 0x08 */ s32 entry; /* into MapStreamer.images, or -1 */
-    /* 0x0C */ s32 frame;
-    /* 0x10 */ s32 x;
-    /* 0x14 */ s32 y;
-} MapSlot;
