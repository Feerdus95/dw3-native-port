-/* Creates the map streamer of a file */
-MapStreamer *FIELDSTG_createMapStreamer(s32 file) {
-    MapStreamer *task = createTaskWithId(FIELDSTG_runMapStreamer, sizeof(MapStreamer), 0x7C, FIELD_TASK_MAP);
-
