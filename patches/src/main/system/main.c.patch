@@ -8,6 +8,40 @@
 static RECT BOOT_IMAGE_RECT = { 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT * 2 };
 static void *ROOT_TASK = NULL; /* the task that runs the game mode */
 
+#ifdef NATIVE
+extern s32 FIGHTSTG_battleSounds[]; /* an overlay's table, whose initial values are in the exe */
+
+/* --render-sounds (soundrender.c): the sound is up, so each battle sound asked for is played by the game's own sound code,
+   with its bank loaded as the battle does, and the mix captured; then the program ends */
+static void nativeRenderSounds(void) {
+    s32 i, index;
+
+    for (i = 0; (index = native_render_next(i)) >= 0; i++) {
+        s32 id = FIGHTSTG_battleSounds[index];
+
+        if (id == 0 || (id >> 30 & 1)) { /* nothing, or the music (exclusive) */
+            continue;
+        }
+        SOUND.stopAll();
+        if (findSoundBank(SOUND_BANK(id)) == -1) {
+            SOUND.loadBank(SOUND_BANK(id));
+            while (SOUND.isLoading()) {
+                FILE_CACHE.update();
+                SOUND.updateLoading();
+            }
+        }
+        native_render_begin(index);
+        SOUND.playSound(id);
+        do {
+            SsSeqCalledTbyT();
+        } while (native_render_frame());
+        SOUND.stopSound(id);
+        native_render_end(index);
+    }
+    native_render_done();
+}
+#endif
+
 /* Starts the hardware, the libraries and the engine, then runs a frame per iteration */
