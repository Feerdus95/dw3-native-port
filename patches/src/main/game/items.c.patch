 u8 getItemCategory(s32 id) {
+#ifdef NATIVE
+    /* the item screen asks for item 0 before one is under the cursor: getItem
+       is NULL there, and the PSX read its type from address 9 */
+    if (getItem(id) == NULL) {
+        return 0;
+    }
+#endif
     return ITEM_TYPE_CATEGORIES[getItem(id)->type];
 }
 
