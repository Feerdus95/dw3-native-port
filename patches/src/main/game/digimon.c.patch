+    static const u8 KNOWN[5] = {30, 45, 60, 80, 99};
+    DigimonData *d = &DIGIMON_DATA[NATIVE_BLADEGARURUMON_DATA];
+    u8 nameId = d->nameId;
+    s32 i;
+
+    *d = DIGIMON_DATA[40]; /* MetalGarurumon */
+    d->id = NATIVE_BLADEGARURUMON;
+    d->nameId = nameId;
