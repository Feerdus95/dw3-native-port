+void native_bladegarurumon_setup(void) {
+    static const u16 STATS[5] = {30, 15, 55, 35, 65}; /* strength, defense, spirit, wisdom, speed */
+    static const u16 RESISTS[7] = {0, 0, 40, 40, 80, 80, 40};
