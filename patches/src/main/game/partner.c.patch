+#ifdef NATIVE
+/* listPartnerEntries into room for max ids: PARTNER_ENTRY_COUNT, or one more
+   for BladeGarurumon past a partner's 44 */
+s32 native_list_partner_entries(s32 partner, u16 *out, s32 max) {
+    s32 i;
+    s32 n;
+
+    for (n = i = 0; i < PARTNER_ENTRY_COUNT; i++) {
+        if (GAME.partners[partner].info.entries[i].id >= FIRST_ENTRY_ID) {
+            out[n] = GAME.partners[partner].info.entries[i].id;
+            n++;
+        }
+    }
+    for (i = 0; i < NATIVE_EXTRA_FORMS; i++) {
+        if (native_form_id(i) != 0 && hasForm(partner, native_form_id(i)) && n < max) {
+            out[n++] = native_form_id(i);
+        }
+    }
+    for (i = n; i < max; i++) {
+        out[i] = 0;
+    }
+    return n;
+}
+#endif
+
