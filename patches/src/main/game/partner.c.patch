@@ -1,4 +1,57 @@
 #include "game.h"
+
+#ifdef NATIVE
+/* BladeGarurumon (native.h): every partner can have it past its 44 Digimon,
+   as entry PARTNER_ENTRY_COUNT, kept where the save has bytes nothing uses,
+   so a card stays the game's (a PSX just doesn't see it): its level (0
+   while the partner hasn't it) and exp in the partner's pad, and which of
+   its six skills it has, known and marked, 3 bits each, in GAME.pad10 (3
+   bytes a partner). A skill is its own (DigimonData.skills[i + 1]) */
+#define BG_ENTRY PARTNER_ENTRY_COUNT
+
+static s32 hasBladeGarurumon(s32 partner) {
+    return GAME.partners[partner].pad[0] != 0;
+}
+
+static void getBladeGarurumon(s32 partner, PartnerEntry *out) {
+    u8 *p = GAME.partners[partner].pad;
+    u8 *f = &GAME.pad10[partner * 3];
+    DigimonData *d = &DIGIMON_DATA[NATIVE_BLADEGARURUMON_DATA];
+    u32 bits = f[0] | f[1] << 8 | f[2] << 16;
+    s32 i;
+
+    out->id = NATIVE_BLADEGARURUMON;
+    out->level = p[0];
+    out->exp = p[1] | p[2] << 8 | p[3] << 16;
+    for (i = 0; i < 6; i++, bits >>= 3) {
+        out->skills[i] = !(bits & 1) ? 0
+                                     : d->skills[i + 1] | (bits & 2 ? SKILL_KNOWN : 0) | (bits & 4 ? SKILL_MARKED : 0) |
+                                           (i == 5 ? SKILL_LAST : 0);
+    }
+}
+
+static void setBladeGarurumon(s32 partner, PartnerEntry *in) {
+    u8 *p = GAME.partners[partner].pad;
+    u8 *f = &GAME.pad10[partner * 3];
+    DigimonData *d = &DIGIMON_DATA[NATIVE_BLADEGARURUMON_DATA];
+    u32 bits = 0;
+    s32 i;
+
+    p[0] = in->level < 1 ? 1 : in->level;
+    p[1] = in->exp, p[2] = in->exp >> 8, p[3] = in->exp >> 16; /* up to 9999999: 24 bits */
+    for (i = 0; i < 6; i++) {
+        if (in->skills[i] != 0 && (in->skills[i] & SKILL_ID) == (d->skills[i + 1] & SKILL_ID)) {
+            bits |= (1 | (in->skills[i] & SKILL_KNOWN ? 2 : 0) | (in->skills[i] & SKILL_MARKED ? 4 : 0)) << (i * 3);
+        }
+    }
+    f[0] = bits, f[1] = bits >> 8, f[2] = bits >> 16;
+}
+
+/* an entry's id, BladeGarurumon's past the 44 */
+static s32 entryId(s32 partner, s32 index) {
+    return index == BG_ENTRY ? NATIVE_BLADEGARURUMON : GAME.partners[partner].info.entries[index].id;
+}
+#endif
 
