 #include "game.h"
 
+#ifdef NATIVE
+/* The port's extra forms (native.h: BladeGarurumon and the Digimon mods): every partner can have them past its 44 Digimon, as entries
+   PARTNER_ENTRY_COUNT and up, kept in the port's store of extra forms (platform/forms.c), which
+   a card's file carries in its unused tail (an area a slot): its level (0 while the
+   partner hasn't it), exp, and which of its six skills it has, known and marked, 3 bits
+   each. So the game's own bytes stay a standard card's. A skill is its own
+   (DigimonData.skills[i + 1]).
+
+   The port's first versions kept them in the game's own bytes nothing uses: the
+   partner's pad (level, exp) and GAME.pad10 (3 bytes the skills). Those are still
+   written, so a save played here still loads in such a version, and read: a save from
+   one has no record, so its form is made from them as the slot loads
+   (native_extra_loaded), and where both have it, the one that got further is kept */
+#define BG_ENTRY PARTNER_ENTRY_COUNT
+
+static s32 hasForm(s32 partner, s32 id) {
+    return native_form_get(partner, id, NULL);
+}
+
+static void getForm(s32 partner, s32 id, PartnerEntry *out) {
+    NativeForm form;
+    DigimonData *d = &DIGIMON_DATA[native_form_slot(id)];
+    u32 bits;
+    s32 i;
+
+    if (!native_form_get(partner, id, &form)) {
+        form.level = 0, form.exp = 0, form.skills = 0;
+    }
+    bits = form.skills;
+    out->id = id;
+    out->level = form.level;
+    out->exp = form.exp;
+    for (i = 0; i < 6; i++, bits >>= 3) {
+        out->skills[i] = !(bits & 1) ? 0
+                                     : d->skills[i + 1] | (bits & 2 ? SKILL_KNOWN : 0) | (bits & 4 ? SKILL_MARKED : 0) |
+                                           (i >= 6 - native_form_signatures(id) ? SKILL_LAST : 0);
+    }
+}
+
+static void setForm(s32 partner, s32 id, PartnerEntry *in) {
+    NativeForm form;
+    u8 *p = GAME.partners[partner].pad;
+    u8 *f = &GAME.pad10[partner * 3];
+    DigimonData *d = &DIGIMON_DATA[native_form_slot(id)];
+    u32 bits = 0;
+    s32 i;
+
+    for (i = 0; i < 6; i++) {
+        if (in->skills[i] != 0 && (in->skills[i] & SKILL_ID) == (d->skills[i + 1] & SKILL_ID)) {
+            bits |= (1 | (in->skills[i] & SKILL_KNOWN ? 2 : 0) | (in->skills[i] & SKILL_MARKED ? 4 : 0)) << (i * 3);
+        }
+    }
+    form.partner = partner, form.id = id;
+    form.level = in->level < 1 ? 1 : in->level;
+    form.exp = in->exp & 0xFFFFFF; /* up to 9999999: 24 bits */
+    form.skills = bits;
+    native_form_set(&form);
+    if (id == NATIVE_BLADEGARURUMON) { /* only the first version's form has the old bytes */
+        p[0] = form.level;
+        p[1] = form.exp, p[2] = form.exp >> 8, p[3] = form.exp >> 16;
+        f[0] = bits, f[1] = bits >> 8, f[2] = bits >> 16;
+    }
+}
+
+/* A slot is in GAME (stgmcard/saves.c, after a load): its forms are the game's, and
+   BladeGarurumon in the old bytes is the form's too if the slot had none, or got
+   further than it */
+void native_extra_loaded(void) {
+    NativeForm old;
+    s32 partner;
+
+    native_forms_commit();
+    for (partner = 0; partner < 8; partner++) {
+        u8 *p = GAME.partners[partner].pad;
+        u8 *f = &GAME.pad10[partner * 3];
+
+        if (p[0] != 0) {
+            old.partner = partner, old.id = NATIVE_BLADEGARURUMON;
+            old.level = p[0], old.exp = p[1] | p[2] << 8 | p[3] << 16, old.skills = f[0] | f[1] << 8 | f[2] << 16;
+            native_form_merge_legacy(&old);
+        }
+    }
+    /* --give ID (a development aid): the form at level 70 with all its skills, for every
+       partner that lacks it. It goes into the card with the next save: use a copy of it */
+    if (g_give_form > 0 && native_form_slot(g_give_form) >= 0) {
+        for (partner = 0; partner < 8; partner++) {
+            if (!hasForm(partner, g_give_form)) {
+                PartnerEntry entry = {0};
+                s32 i;
+
+                entry.level = 70;
+                for (i = 0; i < 6; i++) {
+                    entry.skills[i] = DIGIMON_DATA[native_form_slot(g_give_form)].skills[i + 1] | SKILL_KNOWN;
+                }
+                setForm(partner, g_give_form, &entry);
+            }
+        }
+    }
+}
+
+/* an entry's id, an extra form's past the 44 */
+static s32 entryId(s32 partner, s32 index) {
+    return index >= BG_ENTRY ? native_form_id(index - BG_ENTRY) : GAME.partners[partner].info.entries[index].id;
+}
+#endif
+
