+#define SAVE_TEXT 147
+#define QUIT_TEXT 142
+#define QUIT_ASK_TEXT 143
+#define QUIT_ANSWER_TEXT 144
+#define QUIT_BANNER_X 0x84 /* the question is longer than the title's text */
+static s32 quitAsk;
