+/* A row's text: the game's, the journal's, SAVE's or Quit's */
+static void setFieldRow(FieldMenu *task, FieldMenuWindows *win, s32 i) {
+    void *own = (void *)native_packs_text(LANGUAGE);
+
+    if (i == task->count - 1) {
+        win->options[i]->setString(win->options[i], own, QUIT_TEXT);
+    } else if (g_save_anywhere && i == task->count - 2) {
+        win->options[i]->setString(win->options[i], own, SAVE_TEXT);
+    } else if (i == task->extraOption + 5) {
+        win->options[i]->setString(win->options[i], own, 15);
+    } else {
+        win->options[i]->setString(win->options[i], FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)),
+                                   FIELD_MENU_OPTIONS[task->extraOption][i]);
+    }
+}
+
+/* Shows the question, or the rows again */
+static void showQuitAsk(FieldMenu *task, FieldMenuWindows *win, s32 ask) {
+    void *own = (void *)native_packs_text(LANGUAGE);
+    s32 i;
+
+    if (ask) {
+        quitRows = task->count;
+        task->count = 3;
+        win->title->setPos(win->title, QUIT_BANNER_X, 0x13);
+        win->title->setString(win->title, own, QUIT_ASK_TEXT);
+        for (i = 0; i < 3; i++) {
+            win->options[i]->setString(win->options[i], own, QUIT_ANSWER_TEXT + i);
+            win->options[i]->setPalette(win->options[i], PALETTE_WHITE);
+        }
+        for (i = 3; i < quitRows; i++) {
+            win->options[i]->setVisible(win->options[i], 0);
+        }
+    } else {
+        task->count = quitRows;
+        win->title->setPos(win->title, 0x98, 0x13);
+        win->title->setString(win->title, FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)), 0x13);
+        for (i = 0; i < task->count; i++) {
+            setFieldRow(task, win, i);
+            win->options[i]->setVisible(win->options[i], 1);
+            win->options[i]->setPalette(win->options[i], i == 2 && task->option2Enabled == 0 ? PALETTE_GREY : PALETTE_WHITE);
+        }
+    }
+    quitAsk = ask;
+    task->cursor = ask ? 2 : task->count - 1; /* cancel / the Quit row */
+    win->cursor->setPos(win->cursor, 0xB0, task->cursor * 14 + 0x31);
+}
+
+/* While it asks: up and down choose, X answers, triangle cancels. 1 to go to
+   the title screen */
+static s32 answerQuit(FieldMenu *task, FieldMenuWindows *win) {
+    s32 prev = task->cursor;
+
+    if (PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) {
+        if (--task->cursor < 0) {
+            task->cursor = 0;
+        }
+    } else if (PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) {
+        if (++task->cursor > 2) {
+            task->cursor = 2;
+        }
+    }
+    if (prev != task->cursor) {
+        SOUND.playSound(SOUND_CURSOR);
+        win->cursor->setPos(win->cursor, 0xB0, task->cursor * 14 + 0x31);
+    } else if (PAD_PRESSED(PAD_CROSS)) {
+        SOUND.playSound(SOUND_SELECT);
+        if (task->cursor == 1) {
+            native_quit();
+        }
+        if (task->cursor == 0) {
+            quitToTitle = 1;
+            return 1;
+        }
+        showQuitAsk(task, win, 0);
+    } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        showQuitAsk(task, win, 0);
+    }
+    return 0;
+}
+#endif
