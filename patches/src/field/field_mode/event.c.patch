+#ifdef NATIVE
+/* skip_scenes (native.h): the skip button held through an event that holds the
+   characters (not those of 8000 to 8999) closes its boxes and runs the rest of
+   its script at once: the talks and waits left out, the walks and the camera
+   at their ends, the rest (poses, commands, a leave) as the script has them;
+   then the event ends as it would, its end() setting the story's flags */
+static s32 FIELDSTG_skipEvent(EventTask *task, EventChildren *children) {
+    s32 i;
+
+    if ((task->event >= 8000 && task->event < 9000) || !NATIVE_SKIP_HELD()) {
+        return 0;
+    }
+    for (i = 0; i < 3; i++) {
+        TASK_REGISTRY.funcs.kill((Task *)children->boxes[i]);
+        children->boxes[i] = NULL;
+    }
+    task->wait = 0;
+    return 1;
+}
+#endif
+
