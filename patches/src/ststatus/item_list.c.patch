+
+#ifdef NATIVE
+/*
+ * The journal (native.h), the field menu's last row: a list as the item
+ * list's, in its panels, with the chosen entry's area in the chosen item's
+ * bar and its text in the help panel. Its texts are the port's own
+ * (native_packs_text): 15 its name, 16 the main story, 17 the entry's text
+ */
+#define JOURNAL_ROWS 8
+s32 STSTATUS_objectiveMode(void); /* map_screen.c */
+
+typedef struct Journal {
+    TASK_HEADER(Journal);
+    FieldMenuScreen *menu;
+    s32 layer;
+    s32 depth;
+    s32 count;
+    s32 cursor;
+    s32 spot; /* the objective's area on its map (its name's string), or 0 */
+    s32 textFile; /* that map's area names */
+    PanelAnim fades[3]; /* the list, its title, the bar and the help */
+} Journal;
+
+typedef struct JournalWindows {
+    TextWindow *title;
+    TextWindow *entries[JOURNAL_ROWS];
+    TextWindow *area;
+    TextWindow *help;
+    Cursor *cursor;
+} JournalWindows;
+
+static void showJournal(Journal *journal, JournalWindows *windows, s32 show) {
+    void *own = (void *)native_packs_text(LANGUAGE);
+    s32 i;
+
+    if (show) {
+        windows->title->setString(windows->title, own, 15);
+        windows->entries[0]->setString(windows->entries[0], own, 16);
+        if (journal->spot != 0) {
+            windows->area->setString(windows->area, FILE_CACHE.load(journal->textFile), journal->spot);
+        }
+        windows->help->setString(windows->help, own, 17);
+        windows->cursor->setVisible(windows->cursor, 1);
+    } else {
+        windows->title->setVisible(windows->title, 0);
+        for (i = 0; i < JOURNAL_ROWS; i++) {
+            windows->entries[i]->setVisible(windows->entries[i], 0);
+        }
+        windows->area->setVisible(windows->area, 0);
+        windows->help->setVisible(windows->help, 0);
+        windows->cursor->setVisible(windows->cursor, 0);
+    }
+}
+
+/* The item list's title and panel, the chosen item's bar and the help panel */
+static void drawJournal(Journal *journal) {
+    SpriteDrawer sprite;
+
+    initSpriteDrawer(&sprite);
+    sprite.setTexture(0x280, 0x100);
+    sprite.setLayerId(journal->layer, journal->depth);
+    if (journal->fades[1].level != 0) {
+        sprite.setScale(journal->fades[1].level, ONE, ONE);
+        sprite.setPivot(0xC, 0x17);
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x30, 0xC, 0x12);
+    }
+    if (journal->fades[0].level != 0) {
+        sprite.setScale(ONE, journal->fades[0].level, ONE);
+        sprite.setPivot(0xA0, 0x60);
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x2E, 0, 0x1E);
+    }
+    if (journal->fades[2].level != 0) {
+        sprite.setScale(journal->fades[2].level, ONE, ONE);
+        sprite.setPivot(0x140, 0xB2);
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x2F, 0xF, 0xA5);
+        sprite.setPivot(0, 0xD3);
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x20, 0, 0xC2);
+    }
+}
+
+/* Opens the panels, moves the cursor; triangle closes them and the journal */
+static void runJournal(Journal *journal, JournalWindows *windows) {
+    s32 cursor = journal->cursor;
+    s32 i;
+
+    switch (journal->substate) {
+    case 0:
+    default:
+        for (i = 0; i < 3; i++) {
+            journal->fades[i].duration = 10;
+            STSTATUS_data.funcs.startFade(&journal->fades[i], 1);
+        }
+        journal->substate++;
+        break;
+    case 1:
+        STSTATUS_data.funcs.updateFade(&journal->fades[1]);
+        STSTATUS_data.funcs.updateFade(&journal->fades[2]);
+        if (STSTATUS_data.funcs.updateFade(&journal->fades[0])) {
+            showJournal(journal, windows, 1);
+            journal->substate++;
+        }
+        break;
+    case 2:
+        if (PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) {
+            journal->cursor = journal->cursor > 0 ? journal->cursor - 1 : 0;
+        } else if (PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) {
+            journal->cursor = journal->cursor < journal->count - 1 ? journal->cursor + 1 : journal->count - 1;
+        }
+        if (cursor != journal->cursor) {
+            SOUND.playSound(SOUND_CURSOR);
+            windows->cursor->setPos(windows->cursor, 0x1E, journal->cursor * 14 + 0x25);
+        } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+            showJournal(journal, windows, 0);
+            for (i = 0; i < 3; i++) {
+                STSTATUS_data.funcs.startFade(&journal->fades[i], 0);
+            }
+            journal->substate++;
+        }
+        break;
+    case 3:
+        STSTATUS_data.funcs.updateFade(&journal->fades[1]);
+        STSTATUS_data.funcs.updateFade(&journal->fades[2]);
+        if (STSTATUS_data.funcs.updateFade(&journal->fades[0])) {
+            journal->state = TASK_KILL;
+        }
+        break;
+    }
+}
+
+static void updateJournal(Journal *journal, JournalWindows *windows) {
+    s32 i;
+
+    switch (journal->state) {
+    case TASK_INIT:
+    default:
+        if (journal->textFile != 0 && FILE_CACHE.isLoading(journal->textFile)) {
+            break;
+        }
+        windows->title = createTextWindow(journal->layer, 1, 0x13, 0x14);
+        for (i = 0; i < JOURNAL_ROWS; i++) {
+            windows->entries[i] = createTextWindow(journal->layer, 1, 0x2C, i * 14 + 0x25);
+            windows->entries[i]->setDepth(windows->entries[i], journal->depth - 1);
+        }
+        windows->area = createTextWindow(journal->layer, 1, 0x25, 0xAE);
+        windows->help = createTextWindow(journal->layer, 1, 20, 198);
+        windows->help->setLines(windows->help, 2);
+        windows->cursor = createCursor(journal->layer, journal->depth - 1, 0x1E, journal->cursor * 14 + 0x25);
+        windows->cursor->setVisible(windows->cursor, 0);
+        journal->nextState(journal);
+        break;
+    case TASK_RUN:
+        runJournal(journal, windows);
+        drawJournal(journal);
+        break;
+    case TASK_DONE:
+    case TASK_KILL:
+        break;
+    }
+}
+
+/* Creates the journal (task); requests the area names of its objective's map */
+Task *STSTATUS_createJournal(FieldMenuScreen *menu, s32 extra) {
+    Journal *journal = createTask(updateJournal, sizeof(Journal), sizeof(JournalWindows));
+    s32 mode = STSTATUS_objectiveMode();
+
+    journal->layer = SCREEN_LAYER;
+    journal->depth = 3;
+    journal->menu = menu;
+    journal->count = 1;
+    if (mode != 0) {
+        journal->spot = (STSTATUS_mapAreas[mode & 0xFF] & 0x7F) + 1;
+        journal->textFile = TEXT_FILE(mode >= 0x270 ? TEXT_AMATERASU_MAP : TEXT_ASUKA_MAP);
+        FILE_CACHE.request(journal->textFile);
+    }
+    return (Task *)journal;
+}
+#endif
