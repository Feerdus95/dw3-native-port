+#endif
     if (PAD_HELD(PAD_LEFT) || PAD_HELD(PAD_RIGHT)) {
         if (PAD_PRESSED(PAD_LEFT) || PAD_PRESSED(PAD_RIGHT)) {
             screen->speedX = 2;
@@ -170,6 +304,13 @@
         SOUND.playSound(SOUND_MENU_CANCEL);
         screen->state = TASK_KILL;
     }
+#ifdef NATIVE
+    /* X on an area asks whether to travel there */
+    if (g_fast_travel && screen->hovering && PAD_PRESSED(PAD_CROSS)) {
+        SOUND.playSound(SOUND_MENU_CONFIRM);
+        showFastTravelQuestion(screen, windows, 1);
+    }
+#endif
 }
 
