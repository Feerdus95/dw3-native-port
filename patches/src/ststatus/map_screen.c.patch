     if (PAD_PRESSED(PAD_TRIANGLE)) {
         SOUND.playSound(SOUND_MENU_CANCEL);
         screen->state = TASK_KILL;
+#ifdef NATIVE
+        /* the menu's own map images back, for what it draws after */
+        if ((screen->lateGame != 0) != (screen->menu->lateGame != 0)) {
+            loadServerMapImages(screen->menu->lateGame != 0);
+        }
+#endif
+    }
+#ifdef NATIVE
