+#ifdef NATIVE
+/* Fast travel (native.h): the field the menu goes back to becomes AREA's,
+   in this half of the game, at a door into it from another area that is
+   open now (its slot's conditions), or at its stage's start without one.
+   The field must have been visited. 0 when there is none */
+static s32 fastTravel(s32 area, s32 lateGame) {
+    s32 first = lateGame ? 0x270 : 0x200;
+    s32 last = lateGame ? 0x2D6 : 0x26F;
+    const NativeExit *exits;
+    s32 count;
+    s32 i;
+    s32 x;
+    s32 y;
+    s32 dir;
+
+    exits = native_exits(&count);
+    for (i = 0; i < count; i++) {
+        const NativeExit *e = &exits[i];
+
+        if (e->to < first || e->to > last || (STSTATUS_mapAreas[e->to & 0xFF] & 0x7F) != area ||
+            FLAGS_00.checkCondition((e->to & 0xFF) | 0x2000, 1) != 1) {
+            continue;
+        }
+        if (e->from >= first && e->from <= last && (STSTATUS_mapAreas[e->from & 0xFF] & 0x7F) == area) {
+            continue; /* a door within the area */
+        }
+        if ((e->conditions[0][0] != 0xFFFF && FLAGS_00.checkCondition(e->conditions[0][0], e->conditions[0][1]) == 0) ||
+            (e->conditions[1][0] != 0xFFFF && FLAGS_00.checkCondition(e->conditions[1][0], e->conditions[1][1]) == 0)) {
+            continue;
+        }
+        GAME.fieldMode = e->to;
+        GAME.fieldPos.x = e->x << 8;
+        GAME.fieldPos.y = e->y << 8;
+        GAME.fieldDir = e->dir;
+        GAME.place = e->place;
+        GAME.placeArg = e->placeArg;
+        return 1;
+    }
+    for (i = first; i <= last; i++) {
+        if ((STSTATUS_mapAreas[i & 0xFF] & 0x7F) == area && FLAGS_00.checkCondition((i & 0xFF) | 0x2000, 1) == 1 &&
+            native_stage_start(i, &x, &y, &dir)) {
+            GAME.fieldMode = i;
+            GAME.fieldPos.x = x;
+            GAME.fieldPos.y = y;
+            GAME.fieldDir = dir;
+            GAME.place = 0;
+            GAME.placeArg = 0;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Its question, in a banner as the area's name, on the other half of the
+   screen: the port's own text, then the status texts' yes and no, with a
+   cursor (the screen's windows 1 to 4) */
+#define ASK_YES 0x32
+#define ASK_NO 0x33
+static s32 fastTravelAsking;
+static s32 fastTravelChoice;
+static s32 fastTravelY; /* the banner's */
+
+static void showFastTravelQuestion(StatusMapScreen *screen, TextWindow **windows, s32 show) {
+    Cursor *cursor;
+    s32 i;
+
+    if (show) {
+        fastTravelY = screen->hoverY < screen->height / 2 ? 0x14 : 0xB4;
+        if (windows[1] == NULL) {
+            windows[1] = createTextWindow(screen->layer, 1, 0x10, 0);
+            windows[2] = createTextWindow(screen->layer, 1, 0xC8, 0);
+            windows[3] = createTextWindow(screen->layer, 1, 0xC8, 0);
+            windows[4] = (TextWindow *)createCursor(screen->layer, screen->depth - 3, 0xBB, 0); /* over the banner */
+        }
+        windows[1]->setPos(windows[1], 0x10, fastTravelY + 5);
+        windows[2]->setPos(windows[2], 0xC8, fastTravelY + 5);
+        windows[3]->setPos(windows[3], 0xC8, fastTravelY + 5 + 14);
+        windows[1]->setString(windows[1], (void *)native_packs_text(LANGUAGE), 14);
+        windows[2]->setString(windows[2], FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)), ASK_YES);
+        windows[3]->setString(windows[3], FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)), ASK_NO);
+        fastTravelChoice = 0;
+    } else if (windows[1] != NULL) {
+        for (i = 1; i < 4; i++) {
+            windows[i]->setVisible(windows[i], 0);
+        }
+    }
+    if (windows[4] != NULL) {
+        cursor = (Cursor *)windows[4];
+        cursor->setPos(cursor, 0xBB, fastTravelY + 5 + fastTravelChoice * 14);
+        cursor->setVisible(cursor, show);
+    }
+    fastTravelAsking = show;
+}
+
+/* While it asks: up and down choose, X takes the answer, triangle is no.
+   0 when it doesn't ask */
+static s32 askFastTravel(StatusMapScreen *screen, TextWindow **windows) {
+    s32 choice = fastTravelChoice;
+
+    if (!fastTravelAsking) {
+        return 0;
+    }
+    if (PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) {
+        choice = 0;
+    } else if (PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) {
+        choice = 1;
+    }
+    if (choice != fastTravelChoice) {
+        SOUND.playSound(SOUND_CURSOR);
+        fastTravelChoice = choice;
+        ((Cursor *)windows[4])->setPos((Cursor *)windows[4], 0xBB, fastTravelY + 5 + choice * 14);
+    } else if (PAD_PRESSED(PAD_CROSS)) {
+        /* yes: the home mark moves there, where the menu will go back to */
+        if (choice == 0 && fastTravel(screen->spot - 1, screen->lateGame)) {
+            SOUND.playSound(SOUND_SELECT);
+            screen->homeX = STSTATUS_data.spots[screen->spot].x + 0xC;
+            screen->homeY = STSTATUS_data.spots[screen->spot].y + 0xC;
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+        }
+        showFastTravelQuestion(screen, windows, 0);
+    } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        showFastTravelQuestion(screen, windows, 0);
+    }
+    return 1;
+}
+#endif
+
