+    if (g_fast_travel && PAD_PRESSED(PAD_SQUARE) && screen->state != TASK_KILL && amaterasuVisited() &&
+        serverMapLoaded(screen->lateGame == 0)) {
+        SOUND.playSound(SOUND_MENU_MOVE);
+        showServerMap(screen, screen->lateGame == 0);
+    }
+    /* X on an area asks whether to travel there */
+    if (g_fast_travel && screen->hovering && PAD_PRESSED(PAD_CROSS)) {
+        SOUND.playSound(SOUND_MENU_CONFIRM);
+        showFastTravelQuestion(screen, windows, 1);
     }
+#endif
 }
 
