--- a/src/engine/task/task.c
+++ b/src/engine/task/task.c
@@ -78,12 +78,26 @@
  * childrenSize / 4 child tasks. A nonzero id also registers it (findTask).
  */
 void *createTaskWithId(void (*update)(), s32 size, s32 childrenSize, s32 id) {
+#ifdef NATIVE
+    /* the sizes written as numbers are the PSX's, where a pointer is 4 bytes: a
+       struct is at most twice that with 8-byte ones, and the children are
+       childrenSize / 4 pointers. The same sizes as ever in 32 bits.
+       ponytail: every task doubles in 64 bits; sizeof in the callers that
+       pass a number would save it */
+    Task *task = HEAP.allocZeroed(size * (sizeof(void *) / 4), MEM_MODE);
+
+    if (childrenSize != 0) {
+        task->childCount = childrenSize / 4;
+        task->children = HEAP.allocZeroed(task->childCount * sizeof(void *), MEM_MODE);
+    }
+#else
     Task *task = HEAP.allocZeroed(size, MEM_MODE);
 
     if (childrenSize != 0) {
         task->children = HEAP.allocZeroed(childrenSize, MEM_MODE);
         task->childCount = childrenSize / 4;
     }
+#endif
     task->setState = taskSetState;
     task->setSubstate = taskSetSubstate;
     task->setStep = taskSetStep;
