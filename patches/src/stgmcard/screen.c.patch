         SOUND.stopSound(0x60800000);
         if (screen->step != 0) {
             if (screen->loading == 0) {
+#ifdef NATIVE
+                /* from the field menu's SAVE row (native.h): back to the field */
+                if (g_save_from_menu) {
+                    GAME.funcs.requestMode(GAME.fieldMode, 0);
+                } else
+#endif
                 GAME.funcs.requestMode(GAME.funcs.getPrevMode(), 0);
