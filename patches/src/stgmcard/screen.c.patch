                 GAME.funcs.requestMode(MODE_TITLE, 0);
@@ -74,6 +80,9 @@
             GAME.funcs.requestMode(GAME.fieldMode, 0);
         }
         STGMCARD_funcs.freeBuffers();
+#ifdef NATIVE
+        g_save_from_menu = 0;
