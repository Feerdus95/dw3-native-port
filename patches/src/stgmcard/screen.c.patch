         break;
     }
 }
@@ -90,12 +99,38 @@
     mode = GAME.funcs.getMode() & 0xFF;
     screen->loading = (u32)GAME.funcs.getModeArg() >> 31 ^ 1;
     prev = GAME.funcs.getPrevMode();
+#ifdef NATIVE
+    /* from the field menu (STSTATUS) the area is the field's */
+    if (prev == MODE_STATUS) {
+        prev = GAME.fieldMode;
+    }
+#endif
     for (i = 0; STGMCARD_prevModes[i].mode != 0; i++) {
         if (STGMCARD_prevModes[i].mode == prev) {
             screen->area = STGMCARD_prevModes[i].area;
         }
     }
     screen->place = STGMCARD_places[mode];
+#ifdef NATIVE
+    /* from the menu (native.h): the area and place the banner shows on entering
+       the field (FIELDSTG_areaNames); the place is a string of TEXT_STAGE_NAMES,
+       told from a save point's (TEXT_SHOP_NAMES) by 0x100 (info.c) */
+    if (g_save_from_menu) {
+        extern struct NativeAreaName {
+            u8 area;
+            u8 place;
+            s16 mode;
+        } FIELDSTG_areaNames[];
+
+        screen->place = 0;
+        for (i = 0; FIELDSTG_areaNames[i].mode != 0; i++) {
+            if (FIELDSTG_areaNames[i].mode == GAME.fieldMode) {
